# Copy to .env and fill in only the providers you use. .env is git-ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local models via Ollama (no key needed)
# OLLAMA_API_BASE=http://localhost:11434

# Phase 3: Stack Exchange API app key (raises quota from ~300 to 10k requests/day)
STACKEXCHANGE_KEY=

# Phase 7: Hugging Face (dataset + Spaces publishing)
HF_TOKEN=

# Optional: point at a different config file
# RAGBENCH_CONFIG=config.yaml
